st_filter(bb, .pred = st_disjoint)
nysad_downstate <- nysad |>
st_filter(bb, .pred = st_disjoint)
mapview(nysad_downstate)
nysad |>
st_filter(bb, .pred = st_disjoint)
mapview(nysad |>
st_filter(bb, .pred = st_disjoint))
st_filter(nysad, bb, .predicate = st_disjoint)
