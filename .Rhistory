bb <- read_sf("https://services5.arcgis.com/GfwWNkhOj9bNBqoJ/arcgis/rest/services/NYC_Borough_Boundary/FeatureServer/0/query?where=1=1&outFields=*&outSR=4326&f=pgeojson") |>
st_transform(2263) |>
st_combine()
mapview(bb |> st_transform(4326))
bb <- read_sf("https://services5.arcgis.com/GfwWNkhOj9bNBqoJ/arcgis/rest/services/NYC_Borough_Boundary/FeatureServer/0/query?where=1=1&outFields=*&outSR=4326&f=pgeojson") |>
st_transform(2263)
st_filter(nysad, bb, .predicate = st_intersects)
?st_filter
nysad_downstate <- nysad |>
st_filter(bb, .pred = st_touches)
st_filter(nysad, bb, .predicate = st_touches)
mapview(nysad)
nysad_downstate <- nysad |>
st_filter(bb, .pred = st_overlaps)
bb <- read_sf("https://services5.arcgis.com/GfwWNkhOj9bNBqoJ/arcgis/rest/services/NYC_Borough_Boundary/FeatureServer/0/query?where=1=1&outFields=*&outSR=4326&f=pgeojson") |>
st_transform(2263) |>
st_union()
bb <- read_sf("https://services5.arcgis.com/GfwWNkhOj9bNBqoJ/arcgis/rest/services/NYC_Borough_Boundary/FeatureServer/0/query?where=1=1&outFields=*&outSR=4326&f=pgeojson") |>
st_transform(2263) |>
st_make_valid() |>
st_union()
nysad_downstate <- nysad |>
st_filter(bb, .pred = st_overlaps)
mapview(nysad_downstate)
mapview(bb,nysad_downstate)
?mapview
mapview(list(bb,nysad_downstate))
mapview(bb)
mapview(bb |> st_transform(2263))
mapview(nysad_downstate)
